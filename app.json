{
  "expo": {
    "name": "Λέσχη UoWM",
    "slug": "restaurant-app",
    "version": "1.8.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "restaurantapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.michadasis.restaurantapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.michadasis.restaurantapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/background.png",
        "monochromeImage": "./assets/images/monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#181818",
          "dark": {
            "backgroundColor": "#181818"
          }
        }
      ],
      "expo-web-browser",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayMenuFull",
              "label": "Today's Menu",
              "description": "Shows today's lunch and dinner menu.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "250dp",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayMenuCompact",
              "label": "Today's Menu (Compact)",
              "description": "Shows the next upcoming meal.",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "maxResizeWidth": "380dp",
              "maxResizeHeight": "110dp",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "294753bf-bc7c-4894-bd32-be5a044996ce"
      }
    }
  }
}
