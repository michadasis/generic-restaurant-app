# Copy to .env and fill in from your Supabase project settings > API.
# Only the public anon key belongs here — see .env's own comment for why.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# A SEPARATE Supabase project for user-submitted suggestions — kept apart
# from the menu database above because that one gets overwritten wholesale
# by a daily cron job. Create a second free project and run
# supabase/suggestions.sql in its SQL editor, then fill these in from its
# own API settings.
EXPO_PUBLIC_SUGGESTIONS_SUPABASE_URL=
EXPO_PUBLIC_SUGGESTIONS_SUPABASE_ANON_KEY=
